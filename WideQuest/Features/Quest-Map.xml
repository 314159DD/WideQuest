<Ui xmlns="http://www.blizzard.com/wow/ui/">

	<Frame name="WideQuestMapFrame" inherits="MapCanvasFrameTemplate">
		<Size x="600" y="400"/>
		<Frames>
			<ScrollFrame parentKey="ScrollContainer" inherits="MapCanvasFrameScrollContainerTemplate">
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>
			</ScrollFrame>

			<Frame parentKey="BorderFrame" setAllPoints="true"/>
		</Frames>
	</Frame>

	<Frame name="WideQuestQuestMarkerPinTemplate" mixin="WideQuestPinMixin" virtual="true">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="WideQuestPlayerPinTemplate" mixin="WideQuestPinMixin" virtual="true">
		<Size x="27" y="27"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Arrow" file="Interface\WorldMap\WorldMapArrow" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
</Ui>
